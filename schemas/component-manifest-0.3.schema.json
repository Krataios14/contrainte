{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "enum": [
            "engineering_bundle",
            "exact_geometry",
            "drawing",
            "mesh",
            "scene",
            "material_record",
            "solver_capsule",
            "test_record"
          ],
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "role",
        "media_type",
        "digest",
        "locator"
      ],
      "type": "object"
    },
    "exact_interface_frame": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "additionalProperties": false,
          "properties": {
            "x_axis": {
              "additionalProperties": false,
              "properties": {
                "x": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                },
                "y": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                },
                "z": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "type": "object"
            },
            "y_axis": {
              "additionalProperties": false,
              "properties": {
                "x": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                },
                "y": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                },
                "z": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "type": "object"
            },
            "z_axis": {
              "additionalProperties": false,
              "properties": {
                "x": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                },
                "y": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                },
                "z": {
                  "maxLength": 128,
                  "not": {
                    "const": "-0"
                  },
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
                  "type": "string"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "type": "object"
            }
          },
          "required": [
            "x_axis",
            "y_axis",
            "z_axis"
          ],
          "type": "object"
        },
        "origin": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            "y": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            "z": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "type": "object"
        },
        "reference": {
          "const": "engineering_bundle"
        },
        "unit": {
          "const": "mm"
        }
      },
      "required": [
        "reference",
        "unit",
        "origin",
        "basis"
      ],
      "type": "object"
    },
    "geometry_bounds": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "engineering_bundle"
        },
        "maximum": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            "y": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            "z": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "type": "object"
        },
        "minimum": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            "y": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            "z": {
              "maxLength": 128,
              "not": {
                "const": "-0"
              },
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "type": "object"
        },
        "unit": {
          "const": "mm"
        }
      },
      "required": [
        "frame",
        "unit",
        "minimum",
        "maximum"
      ],
      "type": "object"
    },
    "interface": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output",
            "bidirectional"
          ],
          "type": "string"
        },
        "frame": {
          "$ref": "#/$defs/exact_interface_frame"
        },
        "interface_id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "mechanical",
            "material",
            "electrical",
            "utility",
            "control",
            "safety",
            "spatial"
          ],
          "type": "string"
        },
        "medium": {
          "minLength": 1,
          "type": "string"
        },
        "properties": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "interface_id",
        "kind",
        "direction",
        "medium",
        "frame"
      ],
      "type": "object"
    }
  },
  "$id": "urn:contrainte:schema:component-manifest:0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed public interchange shape. The runtime-only semantic invariants annotation identifies checks that require exact cross-field engineering logic in ComponentManifest.from_dict.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1,
      "type": "array"
    },
    "capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "component_id": {
      "minLength": 1,
      "type": "string"
    },
    "geometry_bounds": {
      "$ref": "#/$defs/geometry_bounds"
    },
    "interfaces": {
      "items": {
        "$ref": "#/$defs/interface"
      },
      "type": "array"
    },
    "lifecycle_state": {
      "enum": [
        "concept",
        "released",
        "retired"
      ],
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "qualification": {
      "enum": [
        "unqualified_demonstration",
        "engineering_reviewed",
        "qualified_for_intended_use"
      ],
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "contrainte.component-manifest/0.3"
    },
    "source_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "component_id",
    "revision",
    "title",
    "lifecycle_state",
    "qualification",
    "source_bundle_digest",
    "artifacts",
    "geometry_bounds"
  ],
  "title": "Contrainte component manifest 0.3",
  "type": "object",
  "x-contrainte-runtime-only-semantic-invariants": [
    {
      "description": "artifact_id values are unique across artifacts.",
      "id": "component.artifact-identifiers-unique"
    },
    {
      "description": "source_bundle_digest identifies exactly one artifact whose role is engineering_bundle and whose digest is identical.",
      "id": "component.source-bundle-linkage"
    },
    {
      "description": "interface_id values are unique across interfaces.",
      "id": "component.interface-identifiers-unique"
    },
    {
      "description": "Every geometry bound parses as a finite decimal and maximum is strictly greater than minimum on each axis.",
      "id": "component.geometry-finite-positive-extent"
    },
    {
      "description": "Every rational scalar is reduced and uses its unique canonical spelling.",
      "id": "component.exact-rationals-reduced"
    },
    {
      "description": "Each interface basis is exactly unit length, mutually orthogonal, and right-handed.",
      "id": "component.frame-basis-orthonormal-right-handed"
    },
    {
      "description": "Each interface frame origin lies within or on geometry_bounds.",
      "id": "component.frame-origin-within-bounds"
    }
  ]
}
